PORT = 4000

FRONTEND_URL = http://localhost:5173

DASHBOARD_URL = http://localhost:5174

# ── PostgreSQL / Prisma ─────────────────────────────────
DATABASE_URL = postgresql://shelf153:shelf153-local-only@localhost:5433/shelf153?schema=public
TEST_DATABASE_URL = postgresql://shelf153:shelf153-local-only@localhost:5433/shelf153_test?schema=public

JWT_EXPIRES_IN = SET_JWT_EXPIRE_VALUE

COOKIE_EXPIRES_IN = SET_COOKIE_EXPIRE_VALUE

JWT_SECRET_KEY = PASTE_YOUR_JWT_SECRET_KEY

SMTP_SERVICE = gmail

SMTP_MAIL = PASTE_YOUR_EMAIL

SMTP_PASSWORD = PASTE_YOUR_EMAIL_APP_PASSWORD

SMTP_HOST = smtp.gmail.com

SMTP_PORT = 465

CLOUDINARY_CLIENT_NAME = PASTE_YOUR_CLOUDINARY_CLOUD_NAME

CLOUDINARY_CLIENT_API = PASTE_YOUR_CLOUDINARY_CLIENT_API
CLOUDINARY_CLIENT_SECRET = PASTE_YOUR_CLOUDINARY_SECRET_KEY

# ── pawaPay Merchant API v2 ────────────────────────────
PAWAPAY_BASE_URL = https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN = PASTE_YOUR_PAWAPAY_API_TOKEN
PAWAPAY_CURRENCY = USD
PAWAPAY_ALLOWED_CURRENCIES = USD,CDF
PAWAPAY_DEFAULT_PROVIDER = AIRTEL_COD
PAWAPAY_ALLOWED_PROVIDERS = AIRTEL_COD,VODACOM_MPESA_COD,ORANGE_COD
PAWAPAY_TIMEOUT_MS = 15000
PAYMENT_RECONCILIATION_AFTER_MINUTES = 15
PAYMENT_RECONCILIATION_INTERVAL_MS = 60000
PAYOUT_RECONCILIATION_AFTER_MINUTES = 15
REFUND_RECONCILIATION_AFTER_MINUTES = 5
PAWAPAY_RECONCILIATION_MAX_DELAY_MINUTES = 360
PAWAPAY_NOT_FOUND_CONFIRMATIONS = 3
PAWAPAY_RECONCILIATION_ALERT_AFTER_ATTEMPTS = 5
PAWAPAY_PAYOUT_CURRENCY = USD
PAWAPAY_PAYOUT_ALLOWED_CURRENCIES = USD,CDF
# Required for customer payments or seller payouts in CDF. Keep this operational rate current.
PAWAPAY_CDF_PER_USD =
PAWAPAY_PAYOUT_ALLOWED_PROVIDERS = AIRTEL_COD,VODACOM_MPESA_COD,ORANGE_COD
MIN_SELLER_PAYOUT_USD = 0

# Optional RFC 9421 protection. Enable only after configuring matching keys in pawaPay.
PAWAPAY_REQUIRE_SIGNED_CALLBACKS = false
PAWAPAY_CALLBACK_PUBLIC_KEY =
PAWAPAY_CALLBACK_KEY_ID =
PAWAPAY_CALLBACK_AUTHORITY =
PAWAPAY_SIGNATURE_CLOCK_SKEW_SECONDS = 300
PAWAPAY_SIGN_FINANCIAL_REQUESTS = false
PAWAPAY_SIGNING_PRIVATE_KEY =
PAWAPAY_SIGNING_KEY_ID =
PAWAPAY_SIGNATURE_ALGORITHM = ecdsa-p256-sha256

# Number of trusted reverse proxies in front of Express. Leave unset locally.
TRUST_PROXY_HOPS =

# The dashboard currently enters prices in local currency and stores USD.
PRICE_INPUT_DIVISOR = 283

# Total platform withholding on product sales. Payment provider fees are included in this rate.
PLATFORM_COMMISSION_RATE = 0.07
