generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String         @id @default(uuid()) @db.Uuid
  name                   String         @db.VarChar(100)
  email                  String         @unique @db.VarChar(100)
  password               String
  role                   String         @default("User") @db.VarChar(10)
  avatar                 Json?
  reset_password_token   String?
  reset_password_expire  DateTime?
  // Sessions issued before this moment are rejected (see utils/passwordPolicy.js).
  password_changed_at    DateTime?
  created_at             DateTime       @default(now())
  products               Product[]
  reviews                Review[]
  orders                 Order[]
  seller_profile         SellerProfile?
  customer_conversations Conversation[] @relation("ConversationCustomer")
  admin_conversations    Conversation[] @relation("ConversationAdmin")
  messages               Message[]
  sold_items             OrderItem[]    @relation("OrderItemSeller")
  seller_payouts         SellerPayout[] @relation("SellerPayoutSeller")

  @@map("users")
}

model SellerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  user_id           String   @unique @db.Uuid
  store_name        String   @db.VarChar(150)
  // Short, stable address of the store's own login page (/boutique/<slug>).
  slug              String?  @unique @db.VarChar(80)
  store_description String?
  store_logo        Json?
  payout_phone      String?  @db.VarChar(20)
  payout_provider   String?  @db.VarChar(50)
  status            String   @default("Approved") @db.VarChar(20)
  created_at        DateTime @default(now())
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @db.VarChar(255)
  description String
  price       Decimal     @db.Decimal(10, 2)
  category    String      @db.VarChar(100)
  ratings     Decimal     @default(0) @db.Decimal(3, 2)
  images      Json?
  stock       Int
  created_by  String      @db.Uuid
  created_at  DateTime    @default(now())
  creator     User        @relation(fields: [created_by], references: [id], onDelete: Restrict)
  reviews     Review[]
  order_items OrderItem[]

  @@index([created_by])
  @@index([category])
  @@map("products")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  product_id String   @db.Uuid
  user_id    String   @db.Uuid
  rating     Decimal  @db.Decimal(2, 1)
  comment    String
  created_at DateTime @default(now())
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([product_id, user_id])
  @@index([user_id])
  @@map("reviews")
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  buyer_id        String        @db.Uuid
  total_price     Decimal       @db.Decimal(10, 2)
  tax_price       Decimal       @db.Decimal(10, 2)
  shipping_price  Decimal       @db.Decimal(10, 2)
  order_status    String        @default("Processing") @db.VarChar(50)
  paid_at         DateTime?
  stock_reserved  Boolean       @default(true)
  idempotency_key String?       @db.VarChar(64)
  created_at      DateTime      @default(now())
  buyer           User          @relation(fields: [buyer_id], references: [id], onDelete: Restrict)
  order_items     OrderItem[]
  shipping_info   ShippingInfo?
  payment         Payment?

  @@unique([buyer_id, idempotency_key])
  @@index([buyer_id, created_at])
  @@map("orders")
}

model OrderItem {
  id                     String        @id @default(uuid()) @db.Uuid
  order_id               String        @db.Uuid
  product_id             String        @db.Uuid
  seller_id              String?       @db.Uuid
  payout_id              String?       @db.Uuid
  quantity               Int
  price                  Decimal       @db.Decimal(10, 2)
  gross_amount           Decimal       @db.Decimal(12, 2)
  commission_rate        Decimal       @db.Decimal(7, 6)
  platform_commission    Decimal       @db.Decimal(12, 2)
  seller_net_amount      Decimal       @db.Decimal(12, 2)
  refunded_gross_amount  Decimal       @default(0) @db.Decimal(12, 2)
  refunded_commission    Decimal       @default(0) @db.Decimal(12, 2)
  refunded_seller_amount Decimal       @default(0) @db.Decimal(12, 2)
  item_status            String        @default("Processing") @db.VarChar(50)
  image                  String?
  title                  String?
  order                  Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product                Product       @relation(fields: [product_id], references: [id], onDelete: Restrict)
  seller                 User?         @relation("OrderItemSeller", fields: [seller_id], references: [id], onDelete: SetNull)
  payout                 SellerPayout? @relation(fields: [payout_id], references: [id], onDelete: SetNull)
  refunds                SaleRefund[]

  @@index([order_id])
  @@index([seller_id])
  @@index([payout_id])
  @@map("order_items")
}

model ShippingInfo {
  id        String @id @default(uuid()) @db.Uuid
  order_id  String @unique @db.Uuid
  full_name String @db.VarChar(100)
  state     String @db.VarChar(100)
  city      String @db.VarChar(100)
  country   String @db.VarChar(100)
  address   String
  pincode   String @db.VarChar(20)
  phone     String @db.VarChar(20)
  order     Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("shipping_info")
}

model Payment {
  id                     String       @id @default(uuid()) @db.Uuid
  order_id               String       @unique @db.Uuid
  payment_type           String       @default("pawaPay") @db.VarChar(20)
  payment_status         String       @default("Pending") @db.VarChar(20)
  transaction_id         String       @unique @db.VarChar(255)
  provider               String       @default("AIRTEL_COD") @db.VarChar(50)
  amount                 Decimal      @db.Decimal(12, 2)
  currency               String       @default("USD") @db.VarChar(3)
  source_currency        String       @default("USD") @db.VarChar(3)
  exchange_rate          Decimal      @default(1) @db.Decimal(18, 6)
  accounting_currency    String       @default("USD") @db.VarChar(3)
  commission_rate        Decimal      @db.Decimal(7, 6)
  gross_sales_amount     Decimal      @db.Decimal(12, 2)
  gross_commission       Decimal      @db.Decimal(12, 2)
  payment_fee            Decimal      @default(0) @db.Decimal(12, 2)
  payment_fee_refunded   Decimal      @default(0) @db.Decimal(12, 2)
  platform_net_revenue   Decimal      @db.Decimal(12, 2)
  seller_net_amount      Decimal      @db.Decimal(12, 2)
  refunded_gross_amount  Decimal      @default(0) @db.Decimal(12, 2)
  refunded_commission    Decimal      @default(0) @db.Decimal(12, 2)
  refunded_seller_amount Decimal      @default(0) @db.Decimal(12, 2)
  accounting_status      String       @default("Pending") @db.VarChar(20)
  provider_payload       Json?
  processed_at           DateTime?
  last_checked_at        DateTime?
  check_attempts         Int          @default(0)
  created_at             DateTime     @default(now())
  order                  Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  refunds                SaleRefund[]

  @@index([payment_status, last_checked_at, created_at], map: "payments_reconciliation_idx")
  @@map("payments")
}

model SaleRefund {
  id                      String    @id @default(uuid()) @db.Uuid
  external_reference      String    @unique @db.VarChar(255)
  payment_id              String    @db.Uuid
  order_item_id           String    @db.Uuid
  gross_amount            Decimal   @db.Decimal(12, 2)
  commission_amount       Decimal   @db.Decimal(12, 2)
  seller_amount           Decimal   @db.Decimal(12, 2)
  payment_fee_refund      Decimal   @default(0) @db.Decimal(12, 2)
  platform_net_adjustment Decimal   @db.Decimal(12, 2)
  currency                String    @default("USD") @db.VarChar(3)
  provider_amount         Decimal   @db.Decimal(18, 2)
  provider_currency       String    @db.VarChar(3)
  provider                String    @db.VarChar(50)
  phone                   String    @db.VarChar(20)
  status                  String    @default("Pending") @db.VarChar(20)
  accounting_applied      Boolean   @default(false)
  initiated_by            String?   @db.Uuid
  provider_payload        Json?
  processed_at            DateTime?
  last_checked_at         DateTime?
  next_check_at           DateTime?
  check_attempts          Int       @default(0)
  failure_code            String?   @db.VarChar(100)
  failure_message         String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  payment                 Payment   @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  order_item              OrderItem @relation(fields: [order_item_id], references: [id], onDelete: Restrict)

  @@index([payment_id, created_at])
  @@index([order_item_id, created_at])
  @@index([status, next_check_at, created_at], map: "sale_refunds_reconciliation_idx")
  @@map("sale_refunds")
}

model SellerPayout {
  id               String      @id @db.Uuid
  seller_id        String      @db.Uuid
  amount           Decimal     @db.Decimal(12, 2)
  currency         String      @db.VarChar(3)
  source_amount    Decimal     @db.Decimal(12, 2)
  source_currency  String      @default("USD") @db.VarChar(3)
  exchange_rate    Decimal     @default(1) @db.Decimal(18, 6)
  seller_earnings_amount Decimal @default(0) @db.Decimal(12, 2)
  debt_recovered_amount Decimal  @default(0) @db.Decimal(12, 2)
  payout_fee       Decimal      @default(0) @db.Decimal(12, 2)
  provider         String      @db.VarChar(50)
  phone            String      @db.VarChar(20)
  status           String      @default("Pending") @db.VarChar(20)
  provider_payload Json?
  processed_at     DateTime?
  last_checked_at  DateTime?
  check_attempts   Int         @default(0)
  created_at       DateTime    @default(now())
  seller           User        @relation("SellerPayoutSeller", fields: [seller_id], references: [id], onDelete: Restrict)
  items            OrderItem[]

  @@index([seller_id, created_at])
  @@index([status, last_checked_at, created_at], map: "seller_payouts_reconciliation_idx")
  @@map("seller_payouts")
}

model FinancialLedgerEntry {
  id                 String   @id @default(uuid()) @db.Uuid
  idempotency_key    String   @unique @db.VarChar(255)
  type               String   @db.VarChar(40)
  amount             Decimal  @db.Decimal(18, 2)
  currency           String   @db.VarChar(3)
  order_id           String?  @db.Uuid
  payment_id         String?  @db.Uuid
  seller_id          String?  @db.Uuid
  refund_id          String?  @db.Uuid
  payout_id          String?  @db.Uuid
  external_reference String?  @db.VarChar(255)
  source             String   @default("Automatic") @db.VarChar(20)
  admin_user_id      String?  @db.Uuid
  metadata           Json?
  created_at         DateTime @default(now())

  @@index([seller_id, currency, created_at])
  @@index([order_id, created_at])
  @@index([type, created_at])
  @@map("financial_ledger_entries")
}

model SellerDebt {
  id                String   @id @default(uuid()) @db.Uuid
  seller_id         String   @db.Uuid
  order_id          String   @db.Uuid
  refund_id         String   @unique @db.Uuid
  original_amount   Decimal  @db.Decimal(12, 2)
  recovered_amount  Decimal  @default(0) @db.Decimal(12, 2)
  remaining_amount  Decimal  @db.Decimal(12, 2)
  currency          String   @default("USD") @db.VarChar(3)
  status            String   @default("Open") @db.VarChar(20)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  recoveries        SellerDebtRecovery[]

  @@index([seller_id, status, created_at])
  @@map("seller_debts")
}

model SellerDebtRecovery {
  id          String     @id @default(uuid()) @db.Uuid
  debt_id     String     @db.Uuid
  payout_id   String     @db.Uuid
  amount      Decimal    @db.Decimal(12, 2)
  currency    String     @default("USD") @db.VarChar(3)
  created_at  DateTime   @default(now())
  debt        SellerDebt @relation(fields: [debt_id], references: [id], onDelete: Restrict)

  @@unique([debt_id, payout_id])
  @@index([payout_id])
  @@map("seller_debt_recoveries")
}

model ExchangeRate {
  id                   String   @id @default(uuid()) @db.Uuid
  source_currency      String   @db.VarChar(3)
  destination_currency String   @db.VarChar(3)
  rate                 Decimal  @db.Decimal(18, 6)
  effective_at         DateTime
  active               Boolean  @default(true)
  created_by           String?  @db.Uuid
  created_at           DateTime @default(now())

  @@index([source_currency, destination_currency, active, effective_at])
  @@map("exchange_rates")
}

model FinancialAdjustmentAudit {
  id            String   @id @default(uuid()) @db.Uuid
  entity_type   String   @db.VarChar(40)
  entity_id     String   @db.Uuid
  field         String   @db.VarChar(50)
  previous_value Decimal @db.Decimal(18, 2)
  new_value      Decimal @db.Decimal(18, 2)
  currency       String  @db.VarChar(3)
  reason         String
  source         String  @default("Admin") @db.VarChar(20)
  admin_user_id  String? @db.Uuid
  external_reference String? @unique @db.VarChar(255)
  created_at     DateTime @default(now())

  @@index([entity_type, entity_id, created_at])
  @@map("financial_adjustment_audits")
}

model Conversation {
  id          String    @id @default(uuid()) @db.Uuid
  customer_id String    @db.Uuid
  admin_id    String?   @db.Uuid
  status      String    @default("open") @db.VarChar(20)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  customer    User      @relation("ConversationCustomer", fields: [customer_id], references: [id], onDelete: Cascade)
  admin       User?     @relation("ConversationAdmin", fields: [admin_id], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([customer_id, status, created_at])
  @@map("conversations")
}

model SiteSettings {
  id            String   @id @default("singleton")
  contact_email String?  @db.VarChar(150)
  contact_phone String?  @db.VarChar(20)
  address       String?
  updated_at    DateTime @updatedAt

  @@map("site_settings")
}

model Message {
  id              String       @id @default(uuid()) @db.Uuid
  conversation_id String       @db.Uuid
  sender_id       String       @db.Uuid
  sender_role     String       @db.VarChar(10)
  content         String
  is_read         Boolean      @default(false)
  created_at      DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender          User         @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@map("messages")
}
